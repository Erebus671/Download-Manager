{
  "manifest_version": 3,
  "name": "AtraTech Download Solutions",
  "short_name": "Download Solutions",
  "description": "Sends large browser downloads to the AtraTech Download Solutions app.",
  "version": "1.3.0",
  "browser_specific_settings": {
    "gecko": {
      "id": "downloadsolutions@atratech",
      "strict_min_version": "128.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  },
  "background": {
    "scripts": ["background.js"]
  },
  "permissions": ["downloads", "nativeMessaging", "cookies", "storage", "notifications", "alarms"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_title": "AtraTech Download Solutions",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "incognito": "not_allowed"
}
