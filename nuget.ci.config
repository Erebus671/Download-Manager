<?xml version="1.0" encoding="utf-8"?>
<!--
  CI-only NuGet config (referenced by .github/workflows/ci.yml's configfile option).
  Differs from the repo-root nuget.config in one way: no LocalNuGetFeed entry,
  since that folder is machine-local to the dev box and does not exist on a
  hosted GitHub Actions runner - referencing a missing local folder source is a
  hard NU1301 restore failure once the package cache is empty (as every CI run
  starts), not a soft/skipped warning.

  packageSourceMapping is still required here, same reasoning as the main
  nuget.config: nuget.org has an unrelated public package literally named
  DotNetTestkit (case-insensitive collision, different publisher, old .NET
  Framework only) that would otherwise satisfy the version match instead of
  our own package from GitHubPackages.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="GitHubPackages" value="https://nuget.pkg.github.com/Erebus671/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="Microsoft.*" />
      <package pattern="Newtonsoft.*" />
      <package pattern="coverlet.*" />
      <package pattern="xunit*" />
    </packageSource>
    <packageSource key="GitHubPackages">
      <package pattern="DotNetTestKit*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
