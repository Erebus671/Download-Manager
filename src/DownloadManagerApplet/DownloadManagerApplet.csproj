<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <PropertyGroup>
    <Product>AtraTech Download Solutions</Product>
    <AssemblyTitle>AtraTech Download Solutions</AssemblyTitle>
    <Company>AtraTech</Company>
    <Description>Download queue manager with resumable, retryable downloads.</Description>
    <Version>1.1.0</Version>
  </PropertyGroup>

  <PropertyGroup Condition="'$(AppIconPath)' != '' And Exists('$(AppIconPath)')">
    <ApplicationIcon>$(AppIconPath)</ApplicationIcon>
  </PropertyGroup>

  <Target Name="WarnMissingAppIcon" BeforeTargets="Build" Condition="'$(AppIconPath)' != '' And !Exists('$(AppIconPath)')">
    <Warning Text="AppIconPath '$(AppIconPath)' not found; building with the default icon." />
  </Target>
  
  <ItemGroup>
    <InternalsVisibleTo Include="DownloadManagerApplet.Tests" />
  </ItemGroup>

  <!--
    No NuGet package references: this machine's only configured source is the offline
    Visual Studio package cache, which doesn't carry CommunityToolkit.Mvvm or Serilog.
    MVVM plumbing and file logging are hand-rolled instead (see Mvvm/ and Services/).
  -->

</Project>
