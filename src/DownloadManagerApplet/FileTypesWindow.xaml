<Window x:Class="DownloadManagerApplet.FileTypesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:DownloadManagerApplet.ViewModels"
        xmlns:conv="clr-namespace:DownloadManagerApplet.Converters"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:FileTypesEditorViewModel}"
        Title="Edit file types"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" SizeToContent="WidthAndHeight"
        Background="{StaticResource PanelBrush}"
        FontFamily="Segoe UI" FontSize="13">

    <Window.Resources>
        <conv:StringToVisibilityConverter x:Key="StringToVisibility" />
    </Window.Resources>

    <Border BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" Padding="20">
        <StackPanel Width="520">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <Image x:Name="TitleIcon" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality" Visibility="Collapsed" />
                <TextBlock Text="Edit file types" FontWeight="SemiBold" FontSize="15"
                           Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Foreground="{StaticResource TextDimBrush}" TextWrapping="Wrap" Margin="0,0,0,12"
                       Text="Extensions separated by spaces. Each extension can belong to one category; anything not listed goes to Other files." />

            <ItemsControl ItemsSource="{Binding Rows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:FileTypeRowViewModel}">
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Label}" Foreground="{StaticResource TextBrush}" VerticalAlignment="Top" Margin="0,4,0,0" />
                            <TextBox Grid.Column="1" Text="{Binding ExtensionsText, UpdateSourceTrigger=PropertyChanged}"
                                     TextWrapping="Wrap" AcceptsReturn="False" MinHeight="44" VerticalContentAlignment="Top"
                                     AutomationProperties.AutomationId="{Binding Label, StringFormat='FileTypes_{0}'}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock AutomationProperties.AutomationId="FileTypesErrorText" Text="{Binding ErrorText}" Foreground="{StaticResource ErrBrush}"
                       TextWrapping="Wrap" Margin="0,4,0,0"
                       Visibility="{Binding ErrorText, Converter={StaticResource StringToVisibility}}" />

            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button AutomationProperties.AutomationId="FileTypesResetButton" Content="Reset to defaults" HorizontalAlignment="Left"
                        Command="{Binding ResetCommand}" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button AutomationProperties.AutomationId="FileTypesCancelButton" Content="Cancel" IsCancel="True"
                            Margin="0,0,8,0" MinWidth="72" />
                    <Button AutomationProperties.AutomationId="FileTypesSaveButton" Content="Save" IsDefault="True" MinWidth="72"
                            Style="{StaticResource PrimaryButton}" Click="Save_Click" />
                </StackPanel>
            </Grid>
        </StackPanel>
    </Border>
</Window>
