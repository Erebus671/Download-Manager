<Window x:Class="DownloadManagerApplet.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:conv="clr-namespace:DownloadManagerApplet.Converters"
        xmlns:vm="clr-namespace:DownloadManagerApplet.ViewModels"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="AtraTech Download Solutions" Height="720" Width="960" MinHeight="560" MinWidth="720"
        Background="{StaticResource BackgroundBrush}"
        WindowStyle="None" ResizeMode="CanResize"
        FontFamily="Segoe UI" FontSize="13">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <conv:StatusToBrushConverter x:Key="StatusToBrush" />
        <conv:StatusToTextConverter x:Key="StatusToText" />
        <conv:StatusToResumeLabelConverter x:Key="StatusToResumeLabel" />
        <conv:LogLevelToBrushConverter x:Key="LogLevelToBrush" />
        <conv:StringToVisibilityConverter x:Key="StringToVisibility" />
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <DataTemplate x:Key="DownloadCardTemplate" DataType="{x:Type vm:DownloadItemViewModel}">
            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding FileName}" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis" />
                        <Border Grid.Column="1" Style="{StaticResource StatusPill}">
                            <TextBlock AutomationProperties.AutomationId="{Binding FileName, StringFormat='Status_{0}'}"
                                       Text="{Binding Status, Converter={StaticResource StatusToText}}"
                                       FontSize="11" Foreground="{Binding Status, Converter={StaticResource StatusToBrush}}" />
                        </Border>
                    </Grid>

                    <ProgressBar Value="{Binding ProgressPercent, Mode=OneWay}" Minimum="0" Maximum="100"
                                 Margin="0,6,0,6" Foreground="{Binding Status, Converter={StaticResource StatusToBrush}}" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding ReceivedDisplay}" Foreground="{StaticResource TextDimBrush}" FontSize="11" />
                        <TextBlock Grid.Column="1" Text="{Binding SpeedDisplay}" Foreground="{StaticResource TextDimBrush}" FontSize="11" />
                    </Grid>

                    <TextBlock Text="{Binding LastError}" Foreground="{StaticResource ErrBrush}" FontSize="11"
                               Margin="0,4,0,0" TextWrapping="Wrap"
                               Visibility="{Binding LastError, Converter={StaticResource StringToVisibility}}" />

                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button AutomationProperties.AutomationId="{Binding FileName, StringFormat='Pause_{0}'}"
                                Content="Pause" Style="{StaticResource SmallButton}" Command="{Binding PauseCommand}" Margin="0,0,6,0" />
                        <Button AutomationProperties.AutomationId="{Binding FileName, StringFormat='Resume_{0}'}"
                                Content="{Binding Status, Converter={StaticResource StatusToResumeLabel}}"
                                Style="{StaticResource SmallButton}" Command="{Binding ResumeCommand}" Margin="0,0,6,0" />
                        <Button AutomationProperties.AutomationId="{Binding FileName, StringFormat='Cancel_{0}'}"
                                Content="Cancel" Style="{StaticResource SmallButton}" Command="{Binding CancelCommand}" Margin="0,0,6,0" />
                        <Button Content="Copy URL" Style="{StaticResource SmallButton}" Command="{Binding CopyUrlCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <DockPanel>

        <!-- Custom title bar (themed to match the app; replaces the native chrome) -->
        <Border DockPanel.Dock="Top" Background="{StaticResource PanelAltBrush}"
                BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="0,0,0,1" Height="36">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="12,0,0,0">
                    <Image x:Name="TitleBarIcon" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality" Visibility="Collapsed" />
                    <TextBlock Text="AtraTech Download Solutions" FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource TitleBarButtonStyle}" Click="MinimizeButton_Click"
                            AutomationProperties.AutomationId="MinimizeButton">
                        <Path Data="M0,5 L10,5" Stroke="{StaticResource TextBrush}" StrokeThickness="1" />
                    </Button>
                    <Button Style="{StaticResource TitleBarButtonStyle}" Click="MaximizeRestoreButton_Click"
                            AutomationProperties.AutomationId="MaximizeRestoreButton">
                        <Grid Width="10" Height="10">
                            <Path x:Name="MaximizeIcon" Data="M0.5,0.5 L9.5,0.5 L9.5,9.5 L0.5,9.5 Z"
                                  Stroke="{StaticResource TextBrush}" StrokeThickness="1" />
                            <Path x:Name="RestoreIcon" Visibility="Collapsed"
                                  Data="M2.5,0.5 L9.5,0.5 L9.5,7.5 M0.5,2.5 L7.5,2.5 L7.5,9.5 L0.5,9.5 Z"
                                  Stroke="{StaticResource TextBrush}" StrokeThickness="1" />
                        </Grid>
                    </Button>
                    <Button Style="{StaticResource CloseTitleBarButtonStyle}" Click="CloseButton_Click"
                            AutomationProperties.AutomationId="CloseButton">
                        <Path Data="M0,0 L10,10 M0,10 L10,0" Stroke="{StaticResource TextBrush}" StrokeThickness="1" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Toolbar -->
        <Border DockPanel.Dock="Top" Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="0,0,0,1" Padding="12,8">
            <StackPanel Orientation="Horizontal">
                <Button AutomationProperties.AutomationId="PauseAllButton"
                        Content="Pause All" Command="{Binding PauseAllCommand}" Margin="0,0,8,0" />
                <Button AutomationProperties.AutomationId="ResumeAllButton"
                        Content="Resume All" Command="{Binding ResumeAllCommand}" Margin="0,0,8,0" />
                <Button AutomationProperties.AutomationId="ClearCompletedButton"
                        Content="Clear Completed History" Command="{Binding ClearCompletedCommand}" />
            </StackPanel>
        </Border>

        <!-- Add bar -->
        <Border DockPanel.Dock="Top" Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="0,0,0,1" Padding="12,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="URL:" Foreground="{StaticResource TextDimBrush}"
                           VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBox Grid.Column="1" AutomationProperties.AutomationId="UrlTextBox"
                         Text="{Binding NewDownloadUrl, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Return" Command="{Binding AddDownloadCommand}" />
                    </TextBox.InputBindings>
                </TextBox>
                <TextBlock Grid.Column="2" Text="Save to:" Foreground="{StaticResource TextDimBrush}"
                           VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBox Grid.Column="3" AutomationProperties.AutomationId="FolderTextBox"
                         Text="{Binding NewDownloadFolder, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" />
                <Button Grid.Column="4" Content="Browse" Command="{Binding BrowseFolderCommand}" Margin="0,0,8,0" />
                <Button Grid.Column="5" AutomationProperties.AutomationId="AddButton"
                        Content="Add" Style="{StaticResource PrimaryButton}" Command="{Binding AddDownloadCommand}" />
            </Grid>
        </Border>

        <!-- Status bar -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource PanelAltBrush}"
                BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="0,1,0,0" Padding="12,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Foreground="{StaticResource TextDimBrush}" FontSize="11">
                    <Run Text="{Binding Queue.Count, Mode=OneWay}" /><Run Text=" in queue &#183; " /><Run Text="{Binding History.Count, Mode=OneWay}" /><Run Text=" in history" />
                </TextBlock>
                <TextBlock Grid.Column="1" Foreground="{StaticResource TextDimBrush}" FontSize="11"
                           Text="{Binding Settings.DefaultDownloadFolder}" />
                <Button Grid.Column="2" AutomationProperties.AutomationId="UpdateStatusButton" Margin="16,0,0,0"
                        Content="{Binding Updates.StatusBarText}" Command="{Binding Updates.StatusBarCommand}"
                        Visibility="{Binding Updates.StatusBarText, Converter={StaticResource StringToVisibility}}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource StatusBarLink}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Updates.StatusBarIsError}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource ErrBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </Border>

        <!-- Log panel -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource LogBackgroundBrush}"
                BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="0,1,0,0" Height="140">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding LogEntries}" Margin="8">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock FontFamily="Consolas" FontSize="11" Margin="0,0,0,2"
                                       Foreground="{Binding Level, Converter={StaticResource LogLevelToBrush}}">
                                <Run Text="{Binding Timestamp, StringFormat='[HH:mm:ss]'}" />
                                <Run Text=" " /><Run Text="{Binding Level}" FontWeight="Bold" />
                                <Run Text="  " /><Run Text="{Binding Message}" />
                            </TextBlock>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- Main content -->
        <TabControl>
            <TabItem Header="Queue">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Queue}" Margin="12"
                                  ItemTemplate="{StaticResource DownloadCardTemplate}" />
                </ScrollViewer>
            </TabItem>

            <TabItem Header="History">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding History}" Margin="12"
                                  ItemTemplate="{StaticResource DownloadCardTemplate}" />
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Settings">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="{StaticResource PanelBrush}"
                            BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="0,0,1,0">
                        <StackPanel Margin="0,16,0,0">
                            <RadioButton x:Name="GeneralNav" AutomationProperties.AutomationId="SettingsGeneralNav"
                                         Content="General" GroupName="SettingsNav" IsChecked="True" Style="{StaticResource SettingsNavItem}" />
                            <RadioButton x:Name="UpdatesNav" AutomationProperties.AutomationId="SettingsUpdatesNav"
                                         Content="Updates" GroupName="SettingsNav" Style="{StaticResource SettingsNavItem}" />
                        </StackPanel>
                    </Border>

                    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="24" MaxWidth="520" HorizontalAlignment="Left">

                            <StackPanel Visibility="{Binding IsChecked, ElementName=GeneralNav, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="General" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,16" />

                                <TextBlock Text="Default download folder" Foreground="{StaticResource TextDimBrush}" Margin="0,0,0,4" />
                                <TextBox AutomationProperties.AutomationId="DefaultFolderTextBox"
                                         Text="{Binding Settings.DefaultDownloadFolder, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Text="Max concurrent downloads" Foreground="{StaticResource TextDimBrush}" Margin="0,16,0,4" />
                                <TextBox AutomationProperties.AutomationId="MaxConcurrentTextBox"
                                         Text="{Binding Settings.MaxConcurrentDownloads, UpdateSourceTrigger=PropertyChanged}"
                                         Width="80" HorizontalAlignment="Left" />

                                <TextBlock Text="Max retry attempts" Foreground="{StaticResource TextDimBrush}" Margin="0,16,0,4" />
                                <TextBox AutomationProperties.AutomationId="MaxRetryTextBox"
                                         Text="{Binding Settings.MaxRetryAttempts, UpdateSourceTrigger=PropertyChanged}"
                                         Width="80" HorizontalAlignment="Left" />

                                <TextBlock Text="Minimum log level" Foreground="{StaticResource TextDimBrush}" Margin="0,16,0,4" />
                                <ComboBox AutomationProperties.AutomationId="LogLevelComboBox"
                                          ItemsSource="{Binding LogLevels}" SelectedItem="{Binding Settings.MinimumLogLevel}"
                                          Width="140" HorizontalAlignment="Left" />
                            </StackPanel>

                            <StackPanel Visibility="{Binding IsChecked, ElementName=UpdatesNav, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="Updates" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,16" />

                                <Border Style="{StaticResource CardBorder}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="130" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Current version" Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center" />
                                        <StackPanel Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal">
                                            <TextBlock Text="{Binding Updates.CurrentVersion, Mode=OneWay}" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                            <Border Style="{StaticResource StatusPill}">
                                                <TextBlock AutomationProperties.AutomationId="UpdateSummaryText" Text="{Binding Updates.StatusSummary}"
                                                           FontSize="11" Foreground="{StaticResource TextBrush}" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Last checked" Foreground="{StaticResource TextDimBrush}"
                                                   VerticalAlignment="Center" Margin="0,10,0,0" />
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Updates.LastCheckedDisplay, Mode=OneWay}"
                                                   Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" Margin="0,10,0,0" />
                                        <Button Grid.Row="1" Grid.Column="2" AutomationProperties.AutomationId="CheckNowButton"
                                                Content="Check now" Style="{StaticResource SmallButton}"
                                                Command="{Binding Updates.CheckNowCommand}" Margin="0,10,0,0" />
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource CardBorder}">
                                    <StackPanel>
                                        <CheckBox x:Name="AutoCheckToggle" AutomationProperties.AutomationId="AutoCheckToggle"
                                                  Style="{StaticResource ToggleSwitch}" Content="Check for updates automatically"
                                                  IsChecked="{Binding Settings.CheckForUpdatesAutomatically}" />
                                        <StackPanel Orientation="Horizontal" Margin="44,10,0,0"
                                                    IsEnabled="{Binding IsChecked, ElementName=AutoCheckToggle}">
                                            <TextBlock Text="How often" Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center" Width="90" />
                                            <ComboBox AutomationProperties.AutomationId="UpdateFrequencyComboBox" Width="230"
                                                      ItemsSource="{Binding Updates.Frequencies}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                                      SelectedValue="{Binding Settings.UpdateCheckFrequency}" />
                                        </StackPanel>
                                        <CheckBox AutomationProperties.AutomationId="AutoDownloadToggle" Margin="0,12,0,0"
                                                  Style="{StaticResource ToggleSwitch}" Content="Download updates automatically"
                                                  IsChecked="{Binding Settings.DownloadUpdatesAutomatically}" />
                                    </StackPanel>
                                </Border>

                                <TextBlock Foreground="{StaticResource TextDimBrush}" TextWrapping="Wrap" Margin="2,4,0,0"
                                           Text="Updates come from GitHub Releases. Each installer is checked against the AtraTech release signature before it runs." />
                            </StackPanel>

                            <Button AutomationProperties.AutomationId="SaveSettingsButton"
                                    Content="Save Settings" Style="{StaticResource PrimaryButton}"
                                    Command="{Binding SaveSettingsCommand}"
                                    Margin="0,24,0,24" HorizontalAlignment="Left" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>
        </TabControl>

    </DockPanel>
</Window>
