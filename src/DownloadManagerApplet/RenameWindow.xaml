<Window x:Class="DownloadManagerApplet.RenameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:DownloadManagerApplet.ViewModels"
        xmlns:conv="clr-namespace:DownloadManagerApplet.Converters"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:RenameViewModel}"
        Title="Rename download"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" SizeToContent="WidthAndHeight"
        Background="{StaticResource PanelBrush}"
        FontFamily="Segoe UI" FontSize="13">

    <Window.Resources>
        <conv:StringToVisibilityConverter x:Key="StringToVisibility" />
    </Window.Resources>

    <Border BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" Padding="20">
        <StackPanel Width="440">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                <Image x:Name="TitleIcon" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality" Visibility="Collapsed" />
                <TextBlock Text="Rename download" FontWeight="SemiBold" FontSize="15"
                           Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" />
            </StackPanel>

            <TextBlock Text="File name" Foreground="{StaticResource TextDimBrush}" Margin="0,0,0,4" />
            <TextBox x:Name="NameTextBox" AutomationProperties.AutomationId="RenameTextBox"
                     Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Foreground="{StaticResource TextDimBrush}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"
                       Text="Unfinished downloads take the new name when they complete." />

            <TextBlock AutomationProperties.AutomationId="RenameErrorText" Text="{Binding ErrorText}" Foreground="{StaticResource ErrBrush}"
                       TextWrapping="Wrap" Margin="0,12,0,0"
                       Visibility="{Binding ErrorText, Converter={StaticResource StringToVisibility}}" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button AutomationProperties.AutomationId="RenameCancelButton" Content="Cancel" IsCancel="True"
                        Margin="0,0,8,0" MinWidth="72" />
                <Button AutomationProperties.AutomationId="RenameSaveButton" Content="Rename" IsDefault="True" MinWidth="72"
                        Style="{StaticResource PrimaryButton}" Click="Rename_Click" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
