<Window x:Class="DownloadManagerApplet.RuleEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:DownloadManagerApplet.ViewModels"
        xmlns:conv="clr-namespace:DownloadManagerApplet.Converters"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:RuleEditorViewModel}"
        Title="{Binding Title}"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" SizeToContent="WidthAndHeight"
        Background="{StaticResource PanelBrush}"
        FontFamily="Segoe UI" FontSize="13">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:StringToVisibilityConverter x:Key="StringToVisibility" />
        <Style x:Key="ChoiceRadio" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Margin" Value="0,0,16,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Border BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" Padding="20">
        <StackPanel Width="560">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                <Image x:Name="TitleIcon" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality" Visibility="Collapsed" />
                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="15"
                           Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" />
            </StackPanel>

            <TextBlock Text="Name" Foreground="{StaticResource TextDimBrush}" Margin="0,0,0,4" />
            <TextBox x:Name="NameTextBox" AutomationProperties.AutomationId="RuleNameTextBox"
                     Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />

            <StackPanel Orientation="Horizontal" Margin="0,14,0,8">
                <TextBlock Text="Match" Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center" Margin="0,0,12,0" />
                <RadioButton AutomationProperties.AutomationId="RuleMatchAll" Content="All conditions" GroupName="Match"
                             Style="{StaticResource ChoiceRadio}" IsChecked="{Binding MatchAll}" />
                <RadioButton AutomationProperties.AutomationId="RuleMatchAny" Content="Any condition" GroupName="Match"
                             Style="{StaticResource ChoiceRadio}" IsChecked="{Binding MatchAny}" />
            </StackPanel>

            <ItemsControl ItemsSource="{Binding Conditions}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:ConditionRowViewModel}">
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox Grid.Column="0" ItemsSource="{Binding Fields}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                      SelectedValue="{Binding Field}" Margin="0,0,6,0" AutomationProperties.AutomationId="ConditionField" />
                            <ComboBox Grid.Column="1" ItemsSource="{Binding Operators}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                      SelectedValue="{Binding Operator}" Margin="0,0,6,0" AutomationProperties.AutomationId="ConditionOperator" />
                            <TextBox Grid.Column="2" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding ValueHint}"
                                     AutomationProperties.AutomationId="ConditionValue" />
                            <ComboBox Grid.Column="3" ItemsSource="{Binding Units}" SelectedItem="{Binding Unit}" Width="64" Margin="6,0,0,0"
                                      Visibility="{Binding IsSize, Converter={StaticResource BoolToVisibility}}"
                                      AutomationProperties.AutomationId="ConditionUnit" />
                            <Button Grid.Column="4" Content="&#x2715;" Style="{StaticResource SmallButton}" Margin="6,0,0,0"
                                    Command="{Binding RemoveCommand}" ToolTip="Remove condition" AutomationProperties.AutomationId="ConditionRemove" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button AutomationProperties.AutomationId="AddConditionButton" Content="+ Condition" HorizontalAlignment="Left"
                    Style="{StaticResource SmallButton}" Command="{Binding AddConditionCommand}" Margin="0,2,0,0" />

            <TextBlock Text="Save to" Foreground="{StaticResource TextDimBrush}" Margin="0,14,0,4" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox AutomationProperties.AutomationId="RuleFolderTextBox" Text="{Binding Folder, UpdateSourceTrigger=PropertyChanged}" />
                <Button Grid.Column="1" Content="..." Style="{StaticResource SmallButton}" Margin="6,0,0,0"
                        Command="{Binding BrowseCommand}" ToolTip="Choose folder" AutomationProperties.AutomationId="RuleFolderBrowse" />
            </Grid>
            <TextBlock Foreground="{StaticResource TextDimBrush}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"
                       Text="Placeholders: {site} {channel} {date} {category}. Environment variables like %USERPROFILE% work too." />

            <TextBlock AutomationProperties.AutomationId="RuleErrorText" Text="{Binding ErrorText}" Foreground="{StaticResource ErrBrush}"
                       TextWrapping="Wrap" Margin="0,12,0,0"
                       Visibility="{Binding ErrorText, Converter={StaticResource StringToVisibility}}" />

            <Grid Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button AutomationProperties.AutomationId="RuleDeleteButton" Content="Delete rule" HorizontalAlignment="Left"
                        Foreground="{StaticResource ErrBrush}" Click="Delete_Click"
                        Visibility="{Binding IsExisting, Converter={StaticResource BoolToVisibility}}" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button AutomationProperties.AutomationId="RuleCancelButton" Content="Cancel" IsCancel="True"
                            Click="Cancel_Click" Margin="0,0,8,0" MinWidth="72" />
                    <Button AutomationProperties.AutomationId="RuleSaveButton" Content="Save rule" IsDefault="True"
                            Style="{StaticResource PrimaryButton}" Click="Save_Click" />
                </StackPanel>
            </Grid>
        </StackPanel>
    </Border>
</Window>
